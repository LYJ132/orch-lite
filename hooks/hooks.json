{
  "_sections": {
    "_comment": "Section markers (JSON has no comments): 'ZCode: full dispatch gate' = the PreToolUse entry; 'Codex: injection-only (SubagentStart) + SessionStart' = the SessionStart and SubagentStart entries. Parsers must ignore unknown top-level keys.",
    "ZCode: full dispatch gate": ["PreToolUse"],
    "Codex: injection-only (SubagentStart) + SessionStart": ["SessionStart", "SubagentStart"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.py\"",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session-init.py\"",
            "async": false
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-start.py\"",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-start.py\"",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "spawn_agent|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-validate.py\"",
            "commandWindows": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-validate.py\"",
            "async": false
          }
        ]
      }
    ]
  }
}
