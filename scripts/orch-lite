#!/usr/bin/env python3
# Extensionless on purpose: this is an executable CLI invoked as `scripts/orch-lite`,
# not an importable module -- keep the 100755 exec bit (see .gitattributes: sync tools
# have stripped it, plus rewritten CRLF, and killed every hook).
"""
Orch-lite CLI Tool (1.3.0)

Stateless by design: every fact lives in git (feature/<feature_id> branches,
git worktree list) or in the conversation. feature_id is the sole key --
branch feature/<feature_id>, worktree .worktrees/<feature_id>/, git commit
author (GIT_AUTHOR_NAME=<feature_id>).

Usage:
    orch-lite <command> [options]

Commands:
    repo                  Ensure a usable git repository exists (idempotent): reuse an
                          existing one, initialize only when the project root is
                          unambiguous, never overwrite .gitignore, stop when unclear
    worktree create       Create (or reuse) .worktrees/<feature-id>/ on branch feature/<feature-id>
    worktree list         List worktrees under .worktrees/, grouped by feature branch
    worktree remove       Remove a worktree (never deletes the branch)
    worktree merge        Pre-check with merge-tree, then merge feature/<feature-id> into a branch
    doctor                Hygiene scan: running version, worktree hygiene (dirty worktrees,
                          stale worktrees whose feature branch is already merged -- git
                          worktree list + merged-branch state), feature_id-authored commits
                          made directly on main (first-parent scan); always exits 0
"""

import sys

# Python >= 3.9 guard, before anything else: one human line on stderr, then a
# non-zero exit (unlike the hooks, the CLI has no fail-open path — a state
# mutation half-understood by an old interpreter is worse than a clean stop).
if sys.version_info < (3, 9):
    sys.stderr.write(
        "[orch-lite] CLI requires Python >= 3.9 "
        "(found %d.%d); refusing to run. Upgrade Python or run via "
        "`uv run --python 3.12 <script>`.\n" % sys.version_info[:2]
    )
    sys.exit(1)

import os
import re
import argparse
import json
import subprocess
from pathlib import Path
from typing import Optional, List, Dict, Any

# Constants
# PROJECT_ROOT is the repository's MAIN working tree root — NOT the current
# working directory. It is resolved at command time by _resolve_project_root():
#   * cwd inside a repo subdirectory  -> the repo root (never the subdirectory)
#   * cwd inside a linked worktree    -> the MAIN working tree root (the
#     worktrees live next to the main tree, not inside a worktree)
#   * cwd outside any repo           -> unresolved: every command that needs a
#     repository fails with an explicit error. The CLI never guesses a project
#     root and never initializes a repository on its own.
CWD = Path.cwd()
PROJECT_ROOT = CWD
WORKTREES_DIR = PROJECT_ROOT / ".worktrees"
# Where git commands run. Starts at the invocation directory (so git's own
# repository discovery decides what repository we are in) and is moved to the
# resolved root once the repository is known.
GIT_CWD = CWD


def _run_git(*git_args: str) -> tuple:
    """Run a git command in GIT_CWD. Returns (returncode, combined output). Never raises."""
    return _run_git_in(GIT_CWD, *git_args)


def _run_git_in(cwd: Path, *git_args: str) -> tuple:
    """Run a git command in an explicit directory. Never raises."""
    try:
        proc = subprocess.run(
            ["git", *git_args],
            cwd=str(cwd),
            capture_output=True,
            text=True,
            timeout=30,
        )
        return proc.returncode, ((proc.stdout or "") + (proc.stderr or "")).strip()
    except (OSError, subprocess.SubprocessError) as exc:
        return 1, str(exc)


def _resolve_project_root() -> Optional[Path]:
    """The MAIN working tree root of the repository the cwd belongs to, or None.

    `git worktree list --porcelain` lists the main working tree first, in
    every worktree of the repository — so it answers the question for a cwd
    that sits in a subdirectory or inside a linked worktree. `--show-toplevel`
    is the fallback for repositories without the worktree extension.
    """
    code, out = _run_git_in(CWD, "worktree", "list", "--porcelain")
    if code == 0:
        for line in out.splitlines():
            if line.startswith("worktree "):
                path = Path(line[len("worktree "):].strip())
                if path.is_dir():
                    return path.resolve()
    code, out = _run_git_in(CWD, "rev-parse", "--show-toplevel")
    if code == 0 and out.strip():
        path = Path(out.strip())
        if path.is_dir():
            return path.resolve()
    return None


def _init_project_root() -> bool:
    """Resolve PROJECT_ROOT / WORKTREES_DIR / GIT_CWD for this invocation.

    Returns False when the cwd belongs to no repository — the caller then
    reports an explicit error instead of guessing a location.
    """
    global PROJECT_ROOT, WORKTREES_DIR, GIT_CWD
    root = _resolve_project_root()
    if root is None:
        return False
    PROJECT_ROOT = root
    WORKTREES_DIR = root / ".worktrees"
    GIT_CWD = root
    return True


# ==================== Repository Bootstrap ====================
# The Git-init rules are ENFORCED HERE, not left to the model's prose. The
# executor handbook says what to do; this code guarantees it:
#
#   1. REUSE FIRST — an existing repository is always reused. The root is the
#      repository's main working tree; a nested repo is never created.
#   2. INIT ONLY WHEN UNAMBIGUOUS — a repository is created only when the
#      target directory is unambiguously a project root: it holds files, no
#      parent directory holds a repository, and it is not a workspace of
#      existing child repositories.
#   3. NEVER OVERWRITE — .gitignore keeps its content; the .worktrees/ rule
#      and the secret safety net are appended only when missing. The user's
#      project files ARE the baseline (staged with `git add -A`), so work
#      areas can check them out.
#   4. STOP WHEN UNCLEAR — an ambiguous project root is reported, not guessed.
#
# The baseline commit is required: `git worktree add <dir> main` needs a
# valid commit on the base branch, so a repository without any commit cannot
# host a worktree.

_GITIGNORE_RULE = ".worktrees/"

# Safety-net secret patterns for the bootstrap baseline commit. Bootstrap now
# stages all existing files (`git add -A`) so work areas can check them out,
# and these patterns keep credentials out of that first commit even when the
# user has no .gitignore of their own. Deliberately conservative:
#
# - no `*.key` — test fixtures routinely ship public keys;
# - no `*.secret` — too broad, would swallow legitimately tracked fixtures;
# - `.env*` is intentionally over-broad: negate with `!.env.example` after
#   bootstrap if you track that file.
#
# Only applied during bootstrap. Existing repos keep their own .gitignore
# untouched.
SECRET_SAFETY_NET = (".env*", "*.pem", "*.p12", "id_rsa*", "id_ed25519*")


def _has_commits() -> bool:
    """True when HEAD points at a commit (an unborn branch has none)."""
    code, _ = _run_git("rev-parse", "--verify", "--quiet", "HEAD")
    return code == 0


def _tracked_file_count() -> int:
    """The number of files tracked by HEAD (0 for an empty commit)."""
    code, out = _run_git("ls-tree", "-r", "--name-only", "HEAD")
    if code != 0:
        return 0
    return len([l for l in out.splitlines() if l.strip()])


def _parent_repo_root() -> Optional[Path]:
    """The root of a repository containing the given directory, or None.

    Looks UP the tree, the way git itself does — a child repository is not
    "inside" the parent for this purpose, so the check is done on the
    directory's PARENT, not on the directory itself.
    """
    parent = CWD.parent
    if parent == CWD:  # filesystem root
        return None
    code, out = _run_git_in(parent, "rev-parse", "--show-toplevel")
    if code == 0 and out.strip():
        return Path(out.strip()).resolve()
    return None


def _child_repos(directory: Path) -> List[Path]:
    """Immediate subdirectories of `directory` that are git repositories."""
    found = []
    try:
        children = sorted(p for p in directory.iterdir() if p.is_dir())
    except OSError:
        return found
    for child in children:
        if child.name in (".git", "node_modules", ".venv", "venv", "vendor",
                          "target", "build", "dist", ".cache"):
            continue
        if (child / ".git").exists():
            found.append(child)
    return found


def _ensure_gitignore_rules(root: Path, rules) -> str:
    """Append the given rules to .gitignore, preserving its content.

    Returns a one-line description of what happened. The file is never
    overwritten; a rule is appended only when it is missing.
    """
    gitignore = root / ".gitignore"
    try:
        existing = gitignore.read_text(encoding="utf-8", errors="replace") if gitignore.exists() else ""
    except OSError as exc:
        return "gitignore: could not read (%s)" % exc
    present = {line.strip() for line in existing.splitlines()}
    missing = [r for r in rules if r not in present]
    if not missing:
        return "gitignore: all %d rule(s) already present (not appended)" % len(rules)
    try:
        with gitignore.open("a", encoding="utf-8") as fh:
            if existing and not existing.endswith("\n"):
                fh.write("\n")
            for rule in missing:
                fh.write(rule + "\n")
    except OSError as exc:
        return "gitignore: could not update (%s)" % exc
    return "gitignore: %d rule(s) appended, existing content preserved (%s)" % (
        len(missing), ", ".join(missing))


def _ensure_gitignore_rule(root: Path) -> str:
    """Append the .worktrees/ rule to .gitignore, preserving its content."""
    return _ensure_gitignore_rules(root, (_GITIGNORE_RULE,))


def repo_command(args):
    """Ensure a usable git repository exists for the project (idempotent).

    This is the code-level guarantee behind the executor's bootstrap rules:

      * an existing repository is REUSED (the main working tree is the root;
        no nested repository is ever created);
      * a repository is INITIALIZED only when the project root is
        unambiguous — the directory holds project files, no parent directory
        holds a repository, and it is not a workspace of existing child
        repositories;
      * .gitignore keeps its content and gains the .worktrees/ rule and the
        secret safety net only when missing; the user's project files ARE
        the baseline (staged with `git add -A`), so a work area checks them
        out and every subsequent edit is trackable;
      * an ambiguous project root is REPORTED, never guessed.

    Idempotent: running it twice reports the second run as "reused".
    """
    # (1) REUSE FIRST — an existing repository always wins.
    if _init_project_root():
        note = "reused existing repository"
        if not _has_commits():
            print("Error: the repository at %s has no commit yet" % PROJECT_ROOT)
            print("Hint: `git worktree add` needs a valid commit on the base branch. "
                  "Make one first (an empty commit is enough) and retry.")
            return 1
        print("Repository: %s (%s)" % (PROJECT_ROOT, note))
        print("  .gitignore: %s" % _ensure_gitignore_rule(PROJECT_ROOT))
        print("Note: feature branches are long-lived; never delete the branch when done.")
        return 0

    # (2) No repository at all — is the project root unambiguous?
    root = CWD.resolve()
    entries = [p for p in root.iterdir() if p.name != ".git"] if root.is_dir() else []
    if not entries:
        print("Error: the project root is not clear — %s is empty" % root)
        print("Hint: an empty directory is not unambiguously a project root. "
              "Point the session at the project directory, or initialize the "
              "repository yourself, then retry.")
        return 1

    parent_root = _parent_repo_root()
    if parent_root is not None:
        print("Error: the project root is not clear — %s is inside the repository "
              "at %s, but that repository was not detected from this directory"
              % (root, parent_root))
        print("Hint: run the command from inside %s, or from the repository root."
              % parent_root)
        return 1

    child_repos = _child_repos(root)
    if child_repos:
        print("Error: the project root is not clear — %s is a workspace of existing "
              "repositories:" % root)
        for child in child_repos[:5]:
            print("  - %s" % child.name)
        print("Hint: this is a workspace, not a project — do NOT initialize a "
              "repository here (it would wrap those repositories in a new parent). "
              "Run the command in the project directory instead.")
        return 1

    # (3) Unambiguous project root -> initialize.
    code, out = _run_git_in(root, "init", "-b", "main")
    if code != 0:
        # Older git has no `init -b`; retry without it.
        code, out = _run_git_in(root, "init")
        if code != 0:
            print("Error: git init failed: %s" % out)
            return 1
    if not _init_project_root():
        print("Error: the repository was created but its root could not be resolved")
        return 1

    gitignore_note = _ensure_gitignore_rules(root, (_GITIGNORE_RULE,) + SECRET_SAFETY_NET)

    # The baseline commit stages ALL existing files (`git add -A`), so a work
    # area checks out the user's code — previously only .gitignore was staged,
    # which left worktrees empty of user code and made subsequent edits
    # untrackable. The secret safety net written above keeps credentials out
    # of this first commit. `git worktree add <dir> main` needs a valid commit
    # on the base branch.
    add_code, add_out = _run_git("add", "-A")
    if add_code != 0:
        print("Error: could not stage the project files: %s" % add_out)
        return 1
    commit_code, commit_out = _run_git(
        "-c", "user.name=orchestrator-init", "-c", "user.email=orchestrator@local",
        "commit", "-q", "--allow-empty", "-m", "chore: orchestrator baseline",
    )
    if commit_code != 0:
        print("Error: baseline commit failed: %s" % commit_out)
        return 1

    committed = _tracked_file_count()
    print("Repository initialized: %s" % PROJECT_ROOT)
    print("  branch:   main (created)")
    print("  %s" % gitignore_note)
    print("  baseline: %d file(s) committed (your project files are tracked from the first commit)" % committed)
    print("Note: feature branches are long-lived; never delete the branch when done.")
    return 0


# ==================== Worktree Commands ====================
# Layout: .worktrees/<feature_id>/ at the project root; branch feature/<feature_id>.
# Feature branches are LONG-LIVED: nothing in this CLI ever deletes a branch.
# merge pre-checks with the legacy 3-arg `git merge-tree <base> <l> <r>` because
# git 2.34 (the baseline here) has no `merge-tree --write-tree`. NOTE: the legacy
# form exits 0 even when conflicts exist -- conflicts are only visible in the
# output, so the clean/conflicted decision is made by parsing, not by exit code.

WORKTREE_BRANCH_PREFIX = "feature/"
_MERGE_TREE_FILE_RE = re.compile(r"^\s+(base|our|their|result)\s+(\d{6})\s+([0-9a-f]{4,})\s+(.+?)\s*$")


def _require_git_repo(action: str) -> bool:
    """True when the cwd belongs to a git repository; otherwise print an error + hint.

    Resolving the project root is part of the check: the worktree commands all
    operate on the repository's MAIN working tree, never on the current
    directory. A cwd outside any repository is an explicit, reported failure —
    the CLI never guesses a project root and never initializes a repository.
    """
    if not _init_project_root():
        print(f"Error: {action} requires a git repository, but this directory is not inside one")
        print("Hint: run the command from inside the project repository (any subdirectory "
              "works — the repository root is resolved automatically). The CLI does not "
              "initialize a repository on its own.")
        return False
    return True


def _branch_exists(branch: str) -> bool:
    code, _ = _run_git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}")
    return code == 0


def _branch_checked_out_at(branch: str) -> Optional[str]:
    """Return the worktree path where `branch` (short name) is checked out, else None.

    Uses `git worktree list --porcelain` per the design (case-C detection).
    """
    code, out = _run_git("worktree", "list", "--porcelain")
    if code != 0:
        return None
    wt_path = None
    for line in out.splitlines():
        if line.startswith("worktree "):
            wt_path = line[len("worktree "):].strip()
        elif line.startswith("branch ") and line[len("branch "):].strip() == f"refs/heads/{branch}":
            return wt_path
    return None


def _worktree_status(dir_path: Path):
    """Return (branch, dirty, n_changes) for a worktree directory."""
    code, out = _run_git("-C", str(dir_path), "branch", "--show-current")
    if code != 0:
        return "(not a git worktree)", False, 0
    branch = out.strip() or "(detached HEAD)"
    scode, sout = _run_git("-C", str(dir_path), "status", "--porcelain")
    n = len([l for l in sout.splitlines() if l.strip()]) if scode == 0 else 0
    return branch, scode == 0 and n > 0, n


def _registered_worktree_paths() -> Optional[set]:
    """Absolute paths registered with git (`worktree list --porcelain`), or None on git failure.

    Both the raw and the resolved form of every path are kept: git prints the
    path as registered, while PROJECT_ROOT is resolved — the two can differ
    behind a symlink, and the worktree-reuse check compares them.
    """
    code, out = _run_git("worktree", "list", "--porcelain")
    if code != 0:
        return None
    paths = set()
    for line in out.splitlines():
        if not line.startswith("worktree "):
            continue
        raw = line[len("worktree "):].strip()
        paths.add(raw)
        try:
            paths.add(str(Path(raw).resolve()))
        except OSError:
            pass
    return paths


def _parse_merge_tree_conflicts(out: str):
    """Parse legacy 3-arg `git merge-tree` output (git 2.34).

    The legacy form exits 0 even with conflicts, so detection is parse-based.
    Conflict conditions (verified empirically on git 2.34.1):
      - 'changed in both' / 'added in both' with differing our/their blobs
      - 'removed in remote' with our blob != base blob (modify/delete)
      - 'removed in local'  with their blob != base blob (delete/modify)
    Clean takes (e.g. one-sided edits, deletions of an untouched file, identical
    changes on both sides) produce no section or non-conflicting entries, and are
    not flagged. Returns (files, raw_sections) covering conflicting sections only.
    """
    files: List[str] = []
    raw_sections: List[str] = []
    state = {"section": None, "entries": {}, "names": {}, "current": None}

    def close_section():
        section = state["section"]
        current = state["current"]
        if section is None or current is None:
            return
        entries = state["entries"]
        conflict = False
        if section in ("changed in both", "added in both"):
            conflict = entries.get("our") != entries.get("their")
        elif section == "removed in remote":
            conflict = bool(entries.get("base")) and entries.get("our") not in (None, entries.get("base"))
        elif section == "removed in local":
            conflict = bool(entries.get("base")) and entries.get("their") not in (None, entries.get("base"))
        if conflict:
            for label in ("base", "our", "their"):
                name = state["names"].get(label)
                if name and name not in files:
                    files.append(name)
            raw_sections.append("\n".join(current))
        state["current"] = None

    for line in out.splitlines():
        stripped = line.strip()
        # Section headers sit alone on their line; diff hunks (@@/-/+, indented or
        # not) are section content and never count as headers.
        is_header = bool(stripped) and not line.startswith((" ", "\t", "-", "+", "@"))
        if is_header:
            close_section()
            state["section"] = stripped
            state["entries"] = {}
            state["names"] = {}
            state["current"] = [line]
            continue
        if state["current"] is not None:
            m = _MERGE_TREE_FILE_RE.match(line)
            if m:
                state["entries"][m.group(1)] = m.group(3)
                state["names"][m.group(1)] = m.group(4).strip()
            state["current"].append(line)
    close_section()
    return files, raw_sections


def worktree_create(args):
    """Create (or reuse) .worktrees/<feature-id>/ on branch feature/<feature-id>.

    Idempotent (dsh-validated): an existing .worktrees/<feature-id> that is a
    registered git worktree is REUSED -- its real path is printed with a
    `reused:` line and nothing is created. It refuses only when the branch is
    checked out elsewhere (feature busy). Writes no state.
    """
    if not _require_git_repo("worktree create"):
        return 1

    wt_dir = WORKTREES_DIR / args.feature_id
    branch = WORKTREE_BRANCH_PREFIX + args.feature_id

    if wt_dir.exists():
        registered = _registered_worktree_paths() or set()
        if str(wt_dir) in registered or str(wt_dir.resolve()) in registered:
            print(f"reused: {wt_dir.resolve()}")
            print(f"  branch:   {branch} (worktree already exists; nothing created)")
            print("Note: feature branches are long-lived; never delete the branch when done.")
            return 0
        print(f"Error: worktree directory already exists but is not a registered git worktree: {wt_dir}")
        print(f"Hint: inspect it with `worktree list`, or remove it with `worktree remove --feature-id {args.feature_id}`")
        return 1

    # Case C: branch currently checked out in another worktree -> feature busy
    busy_at = _branch_checked_out_at(branch)
    if busy_at is not None:
        print(f"feature busy: {branch} is checked out at {busy_at}")
        print("Guidance: write-tasks share that existing worktree; read-only tasks may add a detached "
              f"checkout (`git worktree add --detach <dir> {branch}`); otherwise queue until the other task completes.")
        return 2

    if _branch_exists(branch):
        # Case B: branch exists but checked out nowhere -> attach the new worktree to it
        code, out = _run_git("worktree", "add", str(wt_dir), branch)
        how = f"attached existing branch {branch}"
        created_branch = False
    else:
        # Case A: one step -- create the branch from base and check it out in the new worktree
        code, out = _run_git("worktree", "add", "-b", branch, str(wt_dir), args.base)
        how = f"created branch {branch} from {args.base}"
        created_branch = True

    if code != 0:
        # Isolation preparation failed: the caller (main agent) must STOP the
        # write dispatch and report this. It must never fall back to writing
        # in the primary tree — the error is explicit and exits non-zero.
        # `git worktree add -b` creates the branch BEFORE the checkout, so a
        # failure can leave a stray branch behind: remove it again, otherwise
        # the next attempt would attach to a half-initialized feature.
        if created_branch and _branch_exists(branch):
            _run_git("branch", "-D", branch)
        print(f"Error: git worktree add failed: {out}")
        print(f"Guidance: the write task must not be dispatched — its isolation "
              f"workspace could not be prepared. Fix the cause and retry; do not "
              f"write in the primary tree instead.")
        return 1

    print(f"Worktree created: {wt_dir}")
    print(f"  feature:  {args.feature_id}")
    print(f"  branch:   {branch} ({how})")
    # A worktree holds the COMMITTED tree only: files that are not committed
    # yet do not exist inside it. The child would find them missing, so the
    # condition is reported here rather than discovered mid-task.
    untracked = _untracked_paths()
    if untracked:
        print(f"Warning: {len(untracked)} uncommitted path(s) in the primary tree are "
              f"NOT present in the worktree:")
        for path in untracked[:5]:
            print(f"  - {path}")
        if len(untracked) > 5:
            print(f"  ... and {len(untracked) - 5} more")
        print("Guidance: commit them on the base branch first if the task needs them.")
    print("Note: feature branches are long-lived; never delete the branch when done.")
    return 0


def _untracked_paths() -> List[str]:
    """Paths in the primary tree that are not committed (and not ignored).

    They will NOT exist inside a new worktree — the worktree holds the
    committed tree only. The list is advisory, used to warn the caller.
    """
    code, out = _run_git("status", "--porcelain", "--untracked-files=normal")
    if code != 0:
        return []
    paths = []
    for line in out.splitlines():
        if not line.strip():
            continue
        # "??" = untracked; " M"/"A " etc. are modifications of tracked files
        # (those are also absent from a fresh worktree, but the common case
        # by far is the untracked project file).
        if line.startswith("??"):
            paths.append(line[3:].strip())
    return paths


def worktree_list(args):
    """List worktrees under .worktrees/ grouped by branch, plus feature branches with no active worktree.

    Pure git reads: no state file, no cross-read. Stale/merged state is
    doctor's job (git worktree list + merged-branch state).
    """
    if not _require_git_repo("worktree list"):
        return 1

    rows = []  # (branch, feature_id, path, dirty, n_changes)
    if WORKTREES_DIR.is_dir():
        registered = _registered_worktree_paths()
        for child in sorted(WORKTREES_DIR.iterdir()):
            if child.is_dir():
                if registered is not None and str(child) not in registered and str(child.resolve()) not in registered:
                    rows.append(("(not a git worktree)", child.name, child, False, 0))
                    continue
                branch, dirty, n = _worktree_status(child)
                rows.append((branch, child.name, child, dirty, n))

    if not rows:
        print("No worktrees under .worktrees/")
    else:
        print("=== Worktrees (grouped by branch) ===")
        for branch in sorted({r[0] for r in rows}):
            print(f"  {branch}")
            for br, fid, path, dirty, n in sorted(rows, key=lambda r: r[1]):
                if br != branch:
                    continue
                extra = f" ({n} changed file{'s' if n != 1 else ''})" if dirty else ""
                print(f"    {fid}  {path}  [{'dirty' if dirty else 'clean'}{extra}]")

    # Feature branches are long-lived; note the ones with no active worktree anywhere.
    code, out = _run_git("branch", "--list", "feature/*", "--format=%(refname:short)")
    if code == 0:
        active = set()
        c2, wout = _run_git("worktree", "list", "--porcelain")
        if c2 == 0:
            for line in wout.splitlines():
                if line.startswith("branch "):
                    ref = line[len("branch "):].strip()
                    if ref.startswith("refs/heads/"):
                        active.add(ref[len("refs/heads/"):])
        orphans = [b.strip() for b in out.splitlines() if b.strip() and b.strip() not in active]
        if orphans:
            print("Feature branches without an active worktree (kept, not deleted):")
            for b in orphans:
                print(f"  {b}")
    return 0


def worktree_remove(args):
    """Remove .worktrees/<feature-id>/ (uncommitted changes refuse unless --force). Never touches the branch."""
    if not _require_git_repo("worktree remove"):
        return 1

    wt_dir = WORKTREES_DIR / args.feature_id
    if not wt_dir.is_dir():
        print(f"Error: worktree not found: {wt_dir}")
        print("Hint: `worktree list` shows existing worktrees")
        return 1

    if not args.force:
        code, out = _run_git("-C", str(wt_dir), "status", "--porcelain")
        changes = [l for l in out.splitlines() if l.strip()] if code == 0 else []
        if changes:
            print(f"Error: worktree {wt_dir} has {len(changes)} uncommitted change(s):")
            for line in changes[:10]:
                print(f"  {line}")
            print("Refusing to remove. Commit inside the worktree, or pass --force to discard them (the branch is kept either way).")
            return 1

    remove_args = ["worktree", "remove"]
    if args.force:
        remove_args.append("--force")
    remove_args.append(str(wt_dir))
    code, out = _run_git(*remove_args)
    if code != 0:
        print(f"Error: git worktree remove failed: {out}")
        print("Hint: if the directory is a leftover not registered with git, remove it manually")
        return 1
    print(f"Removed worktree: {wt_dir}")
    print("Branch kept (feature branches are long-lived)")
    return 0


def worktree_merge(args):
    """Pre-check with legacy merge-tree, then merge feature/<feature-id> into --into (default main).

    Must run from the main working tree; on conflicts nothing is merged (exit 2).
    """
    if not _require_git_repo("worktree merge"):
        return 1

    feature = WORKTREE_BRANCH_PREFIX + args.feature_id
    into = args.into

    # The merge runs in the MAIN working tree: _require_git_repo resolved
    # PROJECT_ROOT/GIT_CWD to it (the main tree is always the first entry of
    # `git worktree list`), so a subdirectory or a worktree cwd still merges
    # into the main tree's checkout instead of the worktree's.
    _, git_dir = _run_git("rev-parse", "--git-dir")
    _, common_dir = _run_git("rev-parse", "--git-common-dir")
    if os.path.abspath(git_dir.strip()) != os.path.abspath(common_dir.strip()):
        print("Error: run merge from the main working tree, not from inside a worktree")
        return 1

    if not _branch_exists(feature):
        print(f"Error: branch {feature} does not exist")
        return 1
    if not _branch_exists(into):
        print(f"Error: target branch {into} does not exist")
        return 1

    # `git merge` lands on the current branch, so require the main tree to be on <into>
    code, cur = _run_git("branch", "--show-current")
    current = cur.strip() if code == 0 else ""
    if current != into:
        print(f"Error: main working tree is on branch '{current or '(detached HEAD)'}', but --into is '{into}'")
        print(f"Hint: run `git checkout {into}` in the main working tree first")
        return 1

    # Pre-check with the legacy 3-arg form (git 2.34 has no --write-tree).
    # Its exit code is NOT a conflict signal (it exits 0 even with conflicts);
    # the clean/conflicted decision comes from the parsed output below.
    code, base = _run_git("merge-base", into, feature)
    if code != 0:
        print(f"Error: could not compute a merge base between {into} and {feature}: {base}")
        return 1
    mcode, mout = _run_git("merge-tree", base.strip(), into, feature)
    if mcode not in (0, 1):
        print(f"Error: git merge-tree pre-check failed: {mout}")
        return 1

    files, raw_sections = _parse_merge_tree_conflicts(mout)
    if files or raw_sections:
        print(f"Conflicts when merging {feature} into {into}:")
        if files:
            for f in files:
                print(f"  - {f}")
        else:
            print("  (merge-tree reported conflicts but no conflicting file sections were parsed)")
        print()
        for raw in raw_sections:
            print(raw)
            print()
        print("conflicts found — report to user and ask how to proceed (abort / --no-commit manual resolution)")
        return 2

    # Clean -> real merge (--no-ff, merge commit message per design)
    merge_args = ["merge", "--no-ff", feature, "-m", f"Merge {feature} into {into}"]
    # Fresh environments may have no git identity; fall back to a local one.
    _, email = _run_git("config", "--get", "user.email")
    _, name = _run_git("config", "--get", "user.name")
    if not email.strip() or not name.strip():
        merge_args = ["-c", "user.name=orchestrator-merge", "-c", "user.email=orchestrator@local"] + merge_args
    code, out = _run_git(*merge_args)
    if code != 0:
        # Best-effort: never leave a half-merged state behind (rare: rename cases
        # the legacy merge-tree pre-check cannot model).
        if _run_git("rev-parse", "-q", "--verify", "MERGE_HEAD")[0] == 0:
            _run_git("merge", "--abort")
            print("Error: git merge failed unexpectedly; merge aborted, main working tree restored")
        else:
            print("Error: git merge failed (nothing was merged)")
        print(f"  git said: {out}")
        return 1
    print(f"Merged {feature} into {into}")
    print("Branch kept (feature branches are long-lived)")
    return 0


# ==================== Doctor Command ====================
# Hygiene scan. It reports and NEVER blocks: the exit code is always 0. The
# SessionStart hook (session-init.py) probes it for its "Health" section;
# outside a repo it prints a single marker line instead of failing, so the
# probe degrades cleanly. Reads git only — no state file.

_PLUGIN_ROOT = Path(__file__).resolve().parent.parent


def _running_version() -> str:
    """The plugin version, read from the skill's own install manifests."""
    for rel in (".claude-plugin/plugin.json", ".codex-plugin/plugin.json"):
        try:
            data = json.loads((_PLUGIN_ROOT / rel).read_text(encoding="utf-8"))
        except Exception:
            continue
        version = data.get("version") if isinstance(data, dict) else None
        if version:
            return str(version)
    return "unknown"


def _merged_feature_branches() -> List[str]:
    """feature/* branches fully merged into main (git-native integration state)."""
    code, out = _run_git(
        "branch", "--merged", "main", "--list", "feature/*",
        "--format=%(refname:short)",
    )
    if code != 0:
        return []
    return [line.strip() for line in out.splitlines() if line.strip()]


# A commit author that names a FEATURE on main's first-parent chain means a
# child committed directly to main (branch discipline violation).
#
# The author IS the feature_id (the child sets GIT_AUTHOR_NAME=<feature_id>),
# so the shape to match is the feature_id slug rule — the same rule the
# dispatch gate enforces (`^[a-z0-9][a-z0-9._-]*$`). The previous pattern
# (`^[a-z]+-[0-9]{8}-[0-9]+$`) was the pre-1.3.0 task_id shape and matched
# NOTHING since feature_id became a slug: a child committing straight to
# main went undetected. See DEVLOG 2026-10-21.
FEATURE_AUTHOR_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")

# The main agent's own identities. These authors are NOT feature ids and must
# never be flagged: a merge authored by the orchestrator is the legitimate
# integration path.
MAIN_AGENT_AUTHORS = frozenset({
    "orchestrator-merge",
    "orchestrator",
    "orchestrator-init",
})


def _human_authors() -> set:
    """Identities that belong to a PERSON, not to a dispatched child.

    A child's commits are authored as `<feature_id>`; a human's commits are
    authored as the human's own name (`linyujian`, `LYJ132`, ...). Both match
    the slug shape, so the shape alone cannot tell them apart — the human's
    own git identity is the reliable discriminator.

    Sources, in order:
      * the repository's configured `user.name` / `user.email` (the owner);
      * the committer identities of the recent history (the owner commits
        with their own name, so their name shows up there);
      * the known tool identities above.

    Everything else that matches the slug shape is treated as a feature id.
    """
    humans = set(MAIN_AGENT_AUTHORS)
    for key in ("user.name", "user.email"):
        code, out = _run_git("config", "--get", key)
        if code == 0 and out.strip():
            humans.add(out.strip())
    # The owner of the repository: their name appears as an author on the
    # commits they made themselves (merges, chores, releases).
    code, out = _run_git("log", "--first-parent", "-n", "30", "--format=%an%x00%ae", "main")
    if code == 0:
        for line in out.splitlines():
            name, sep, email = line.partition("\x00")
            if not sep:
                continue
            name = name.strip()
            email = email.strip()
            # A child's commit: author name == feature id AND the email is a
            # local one (`<fid>@local`, `<fid>@orch-lite.local`, `child@local`).
            # The email's local part repeats the feature id -> a child, not a
            # human.
            local = email.split("@")[0].strip().lower()
            if name and local and name.lower() == local:
                continue
            if email.lower().endswith("@local") or email.lower().endswith(
                "@orch-lite.local"
            ) or email.lower().endswith("@orch.local"):
                continue
            if name:
                humans.add(name)
    return humans


def _main_violations() -> List[tuple]:
    """feature_id-authored commits sitting DIRECTLY on main's first-parent chain.

    A legitimate integration is a `--no-ff` merge: the feature's own commits
    land on the SECOND parent and are invisible to a first-parent scan. A
    child commit that appears on the FIRST parent chain is a branch-discipline
    violation — the child wrote to main directly.

    Returns (author, short_hash) pairs.
    """
    humans = _human_authors()
    code, out = _run_git(
        "log", "--first-parent", "-n", "30", "--format=%an%x00%ae%x00%h%x00%P", "main"
    )
    if code != 0:
        return []
    found = []
    for line in out.splitlines():
        parts = line.split("\x00")
        if len(parts) < 4:
            continue
        author, email, short, parents = (p.strip() for p in parts[:4])
        if not author:
            continue
        # A merge commit is the main agent's own integration step, never a
        # child's write to main.
        if len(parents.split()) > 1:
            continue
        if author.lower() in humans:
            continue
        if not FEATURE_AUTHOR_RE.match(author):
            continue
        found.append((author, short))
    return found

def doctor_command(args):
    """Hygiene scan: (0) running version, (1) worktree hygiene via git
    worktree list — dirty worktrees and stale worktrees whose feature branch
    is already merged into main, (2) feature_id-authored commits made
    directly on main (a first-parent scan, so merge-integrated feature
    commits do not surface), plus the merged-branch state. Always exits 0."""
    code, _ = _run_git_in(CWD, "rev-parse", "--is-inside-work-tree")
    if code != 0:
        print("(doctor: not a repo)")
        return 0
    # Resolve the project root so the worktree hygiene scan looks at the
    # repository's MAIN working tree, even when doctor runs from a
    # subdirectory. A cwd outside any repository keeps the human line above.
    if not _init_project_root():
        print("(doctor: not a repo)")
        return 0

    print("orch-lite doctor (version %s)" % _running_version())

    findings: List[str] = []
    merged = _merged_feature_branches()

    # (1) worktree hygiene: dirty (uncommitted changes) and stale (the
    # feature branch is already integrated) — both pure git reads.
    if WORKTREES_DIR.is_dir():
        for child in sorted(WORKTREES_DIR.iterdir()):
            if not child.is_dir():
                continue
            fid = child.name
            scode, sout = _run_git("-C", str(child), "status", "--porcelain")
            changes = [l for l in sout.splitlines() if l.strip()] if scode == 0 else []
            if changes:
                paths = ", ".join(l[3:].split(" -> ")[-1] for l in changes[:3])
                findings.append(f"dirty: {fid} ({len(changes)} changes: {paths})")
            if (WORKTREE_BRANCH_PREFIX + fid) in merged:
                findings.append(
                    f"stale: {fid} (feature/{fid} is merged into main; "
                    f"run: worktree remove --feature-id {fid})"
                )

    # (2) feature_id-authored commits made directly on main -- last ~30 on
    # main's first-parent chain, only checked while on main. A legitimate
    # `--no-ff` integration merge puts the feature's commits on the second
    # parent, so they never surface here; a child's own commit on the first
    # parent chain is a branch-discipline violation.
    bcode, bout = _run_git("branch", "--show-current")
    if bcode == 0 and bout.strip() == "main":
        for author, short in _main_violations():
            findings.append(f"main-violation: {author} {short}")

    if findings:
        for finding in findings:
            print(finding)
    else:
        print("doctor: all clear")

    # Merged-branch state: integration status is a git fact, always reported.
    if merged:
        print("Merged feature branches (integrated; kept, never deleted):")
        for branch in merged:
            print(f"  {branch}")
    return 0


# ==================== Main ====================

def main():
    parser = argparse.ArgumentParser(description="Orch-lite CLI")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # worktree
    worktree_parser = subparsers.add_parser(
        "worktree",
        help="Git worktree operations (.worktrees/<feature-id>, branch feature/<feature-id>; branches are long-lived)")
    worktree_sub = worktree_parser.add_subparsers(dest="worktree_cmd", required=True)

    create_wt = worktree_sub.add_parser("create", help="Create (or reuse) .worktrees/<feature-id>/ on branch feature/<feature-id>")
    create_wt.add_argument("--feature-id", required=True, help="Feature ID (worktree directory name; branch feature/<feature-id>)")
    create_wt.add_argument("--base", default="main", help="Base ref when the branch must be created (default: main)")

    worktree_sub.add_parser("list", help="List worktrees under .worktrees/, grouped by feature branch")

    remove_wt = worktree_sub.add_parser("remove", help="Remove a worktree (never deletes the branch)")
    remove_wt.add_argument("--feature-id", required=True, help="Feature ID (worktree directory name)")
    remove_wt.add_argument("--force", action="store_true", help="Discard uncommitted changes and remove anyway")

    merge_wt = worktree_sub.add_parser("merge", help="Pre-check with merge-tree, then merge feature/<feature-id> into --into")
    merge_wt.add_argument("--feature-id", required=True, help="Feature ID -> branch feature/<feature-id>")
    merge_wt.add_argument("--into", default="main", help="Target branch (default: main)")

    # repo
    subparsers.add_parser(
        "repo",
        help="Ensure a usable git repository exists for the project (idempotent): "
             "reuse an existing one, initialize only when the project root is "
             "unambiguous, never overwrite .gitignore, stop when the root is unclear")

    # doctor
    subparsers.add_parser(
        "doctor",
        help="Hygiene scan: running version, worktree hygiene (dirty + merged-stale via git), "
             "main-violation first-parent scan, merged-branch state (always exits 0)")

    args = parser.parse_args()

    # Fail-soft net: an OSError escaping any handler must surface as ONE human
    # line, never a traceback (exit 1: a writer must not pretend success).
    try:
        return _dispatch(args, parser)
    except OSError as exc:
        reason = getattr(exc, "strerror", None) or type(exc).__name__
        print(f"error: {reason}")
        return 1


def _dispatch(args, parser) -> int:
    """Route the parsed args to its command handler (called under the fail-soft net)."""
    if args.command == "worktree":
        if args.worktree_cmd == "create":
            return worktree_create(args)
        elif args.worktree_cmd == "list":
            return worktree_list(args)
        elif args.worktree_cmd == "remove":
            return worktree_remove(args)
        elif args.worktree_cmd == "merge":
            return worktree_merge(args)
    elif args.command == "repo":
        return repo_command(args)
    elif args.command == "doctor":
        return doctor_command(args)

    parser.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
