#!/usr/bin/env python3
# Extensionless on purpose: this is an executable CLI invoked as `scripts/multi-agent`,
# not an importable module -- keep the 100755 exec bit (see .gitattributes: sync tools
# have stripped it, plus rewritten CRLF, and killed every hook).
"""
Orch-lite CLI Tool (1.3.0)

Stateless by design: every fact lives in git (feature/<feature_id> branches,
git worktree list) or in the conversation. feature_id is the sole key --
branch feature/<feature_id>, worktree .worktrees/<feature_id>/, git commit
author (GIT_AUTHOR_NAME=<feature_id>).

Usage:
    multi-agent <command> [options]

Commands:
    worktree create       Create (or reuse) .worktrees/<feature-id>/ on branch feature/<feature-id>
    worktree list         List worktrees under .worktrees/, grouped by feature branch
    worktree remove       Remove a worktree (never deletes the branch)
    worktree merge        Pre-check with merge-tree, then merge feature/<feature-id> into a branch
    doctor                Hygiene scan: dirty worktrees, feature_id-authored commits made
                          directly on main (first-parent scan), HEAD-vs-copy install drift
                          (--compare-dir DIR, default ~/.agents/skills/orch-lite); always exits 0
"""

import sys

# Python >= 3.9 guard, before anything else: one human line on stderr, then a
# non-zero exit (unlike the hooks, the CLI has no fail-open path — a state
# mutation half-understood by an old interpreter is worse than a clean stop).
if sys.version_info < (3, 9):
    sys.stderr.write(
        "[orch-lite] multi-agent requires Python >= 3.9 "
        "(found %d.%d); refusing to run. Upgrade Python or run via "
        "`uv run --python 3.12 <script>`.\n" % sys.version_info[:2]
    )
    sys.exit(1)

import os
import re
import argparse
import hashlib
import subprocess
from pathlib import Path
from typing import Optional, List, Dict, Any

# Constants
PROJECT_ROOT = Path.cwd()
WORKTREES_DIR = PROJECT_ROOT / ".worktrees"


def _run_git(*git_args: str) -> tuple:
    """Run a git command in PROJECT_ROOT. Returns (returncode, combined output). Never raises."""
    try:
        proc = subprocess.run(
            ["git", *git_args],
            cwd=str(PROJECT_ROOT),
            capture_output=True,
            text=True,
            timeout=30,
        )
        return proc.returncode, ((proc.stdout or "") + (proc.stderr or "")).strip()
    except (OSError, subprocess.SubprocessError) as exc:
        return 1, str(exc)


# ==================== Worktree Commands ====================
# Layout: .worktrees/<feature_id>/ at the project root; branch feature/<feature_id>.
# Feature branches are LONG-LIVED: nothing in this CLI ever deletes a branch.
# merge pre-checks with the legacy 3-arg `git merge-tree <base> <l> <r>` because
# git 2.34 (the baseline here) has no `merge-tree --write-tree`. NOTE: the legacy
# form exits 0 even when conflicts exist -- conflicts are only visible in the
# output, so the clean/conflicted decision is made by parsing, not by exit code.

WORKTREE_BRANCH_PREFIX = "feature/"
_MERGE_TREE_FILE_RE = re.compile(r"^\s+(base|our|their|result)\s+(\d{6})\s+([0-9a-f]{4,})\s+(.+?)\s*$")


def _require_git_repo(action: str) -> bool:
    """True when cwd is inside a git repository; otherwise print an error + hint."""
    code, _ = _run_git("rev-parse", "--git-dir")
    if code != 0:
        print(f"Error: {action} requires a git repository, but this is not one")
        print("Hint: bootstrap one first (git init -b main + a baseline commit; "
              "see the orch-lite-executor handbook, git bootstrap steps)")
        return False
    return True


def _branch_exists(branch: str) -> bool:
    code, _ = _run_git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}")
    return code == 0


def _branch_checked_out_at(branch: str) -> Optional[str]:
    """Return the worktree path where `branch` (short name) is checked out, else None.

    Uses `git worktree list --porcelain` per the design (case-C detection).
    """
    code, out = _run_git("worktree", "list", "--porcelain")
    if code != 0:
        return None
    wt_path = None
    for line in out.splitlines():
        if line.startswith("worktree "):
            wt_path = line[len("worktree "):].strip()
        elif line.startswith("branch ") and line[len("branch "):].strip() == f"refs/heads/{branch}":
            return wt_path
    return None


def _worktree_status(dir_path: Path):
    """Return (branch, dirty, n_changes) for a worktree directory."""
    code, out = _run_git("-C", str(dir_path), "branch", "--show-current")
    if code != 0:
        return "(not a git worktree)", False, 0
    branch = out.strip() or "(detached HEAD)"
    scode, sout = _run_git("-C", str(dir_path), "status", "--porcelain")
    n = len([l for l in sout.splitlines() if l.strip()]) if scode == 0 else 0
    return branch, scode == 0 and n > 0, n


def _registered_worktree_paths() -> Optional[set]:
    """Absolute paths registered with git (`worktree list --porcelain`), or None on git failure."""
    code, out = _run_git("worktree", "list", "--porcelain")
    if code != 0:
        return None
    return {line[len("worktree "):].strip() for line in out.splitlines() if line.startswith("worktree ")}


def _parse_merge_tree_conflicts(out: str):
    """Parse legacy 3-arg `git merge-tree` output (git 2.34).

    The legacy form exits 0 even with conflicts, so detection is parse-based.
    Conflict conditions (verified empirically on git 2.34.1):
      - 'changed in both' / 'added in both' with differing our/their blobs
      - 'removed in remote' with our blob != base blob (modify/delete)
      - 'removed in local'  with their blob != base blob (delete/modify)
    Clean takes (e.g. one-sided edits, deletions of an untouched file, identical
    changes on both sides) produce no section or non-conflicting entries, and are
    not flagged. Returns (files, raw_sections) covering conflicting sections only.
    """
    files: List[str] = []
    raw_sections: List[str] = []
    state = {"section": None, "entries": {}, "names": {}, "current": None}

    def close_section():
        section = state["section"]
        current = state["current"]
        if section is None or current is None:
            return
        entries = state["entries"]
        conflict = False
        if section in ("changed in both", "added in both"):
            conflict = entries.get("our") != entries.get("their")
        elif section == "removed in remote":
            conflict = bool(entries.get("base")) and entries.get("our") not in (None, entries.get("base"))
        elif section == "removed in local":
            conflict = bool(entries.get("base")) and entries.get("their") not in (None, entries.get("base"))
        if conflict:
            for label in ("base", "our", "their"):
                name = state["names"].get(label)
                if name and name not in files:
                    files.append(name)
            raw_sections.append("\n".join(current))
        state["current"] = None

    for line in out.splitlines():
        stripped = line.strip()
        # Section headers sit alone on their line; diff hunks (@@/-/+, indented or
        # not) are section content and never count as headers.
        is_header = bool(stripped) and not line.startswith((" ", "\t", "-", "+", "@"))
        if is_header:
            close_section()
            state["section"] = stripped
            state["entries"] = {}
            state["names"] = {}
            state["current"] = [line]
            continue
        if state["current"] is not None:
            m = _MERGE_TREE_FILE_RE.match(line)
            if m:
                state["entries"][m.group(1)] = m.group(3)
                state["names"][m.group(1)] = m.group(4).strip()
            state["current"].append(line)
    close_section()
    return files, raw_sections


def worktree_create(args):
    """Create (or reuse) .worktrees/<feature-id>/ on branch feature/<feature-id>.

    Idempotent (dsh-validated): an existing .worktrees/<feature-id> that is a
    registered git worktree is REUSED -- its real path is printed with a
    `reused:` line and nothing is created. It refuses only when the branch is
    checked out elsewhere (feature busy). Writes no state.
    """
    if not _require_git_repo("worktree create"):
        return 1

    wt_dir = WORKTREES_DIR / args.feature_id
    branch = WORKTREE_BRANCH_PREFIX + args.feature_id

    if wt_dir.exists():
        registered = _registered_worktree_paths() or set()
        if str(wt_dir) in registered or str(wt_dir.resolve()) in registered:
            print(f"reused: {wt_dir.resolve()}")
            print(f"  branch:   {branch} (worktree already exists; nothing created)")
            print("Note: feature branches are long-lived; never delete the branch when done.")
            return 0
        print(f"Error: worktree directory already exists but is not a registered git worktree: {wt_dir}")
        print(f"Hint: inspect it with `worktree list`, or remove it with `worktree remove --feature-id {args.feature_id}`")
        return 1

    # Case C: branch currently checked out in another worktree -> feature busy
    busy_at = _branch_checked_out_at(branch)
    if busy_at is not None:
        print(f"feature busy: {branch} is checked out at {busy_at}")
        print("Guidance: write-tasks share that existing worktree; read-only tasks may add a detached "
              f"checkout (`git worktree add --detach <dir> {branch}`); otherwise queue until the other task completes.")
        return 2

    if _branch_exists(branch):
        # Case B: branch exists but checked out nowhere -> attach the new worktree to it
        code, out = _run_git("worktree", "add", str(wt_dir), branch)
        how = f"attached existing branch {branch}"
    else:
        # Case A: one step -- create the branch from base and check it out in the new worktree
        code, out = _run_git("worktree", "add", "-b", branch, str(wt_dir), args.base)
        how = f"created branch {branch} from {args.base}"

    if code != 0:
        print(f"Error: git worktree add failed: {out}")
        return 1

    print(f"Worktree created: {wt_dir}")
    print(f"  feature:  {args.feature_id}")
    print(f"  branch:   {branch} ({how})")
    print("Note: feature branches are long-lived; never delete the branch when done.")
    return 0


def worktree_list(args):
    """List worktrees under .worktrees/ grouped by branch, plus feature branches with no active worktree.

    Pure git reads: no state file, no cross-read. Stale/merged state is
    doctor's job (git worktree list + merged-branch state).
    """
    if not _require_git_repo("worktree list"):
        return 1

    rows = []  # (branch, feature_id, path, dirty, n_changes)
    if WORKTREES_DIR.is_dir():
        registered = _registered_worktree_paths()
        for child in sorted(WORKTREES_DIR.iterdir()):
            if child.is_dir():
                if registered is not None and str(child) not in registered and str(child.resolve()) not in registered:
                    rows.append(("(not a git worktree)", child.name, child, False, 0))
                    continue
                branch, dirty, n = _worktree_status(child)
                rows.append((branch, child.name, child, dirty, n))

    if not rows:
        print("No worktrees under .worktrees/")
    else:
        print("=== Worktrees (grouped by branch) ===")
        for branch in sorted({r[0] for r in rows}):
            print(f"  {branch}")
            for br, fid, path, dirty, n in sorted(rows, key=lambda r: r[1]):
                if br != branch:
                    continue
                extra = f" ({n} changed file{'s' if n != 1 else ''})" if dirty else ""
                print(f"    {fid}  {path}  [{'dirty' if dirty else 'clean'}{extra}]")

    # Feature branches are long-lived; note the ones with no active worktree anywhere.
    code, out = _run_git("branch", "--list", "feature/*", "--format=%(refname:short)")
    if code == 0:
        active = set()
        c2, wout = _run_git("worktree", "list", "--porcelain")
        if c2 == 0:
            for line in wout.splitlines():
                if line.startswith("branch "):
                    ref = line[len("branch "):].strip()
                    if ref.startswith("refs/heads/"):
                        active.add(ref[len("refs/heads/"):])
        orphans = [b.strip() for b in out.splitlines() if b.strip() and b.strip() not in active]
        if orphans:
            print("Feature branches without an active worktree (kept, not deleted):")
            for b in orphans:
                print(f"  {b}")
    return 0


def worktree_remove(args):
    """Remove .worktrees/<feature-id>/ (uncommitted changes refuse unless --force). Never touches the branch."""
    if not _require_git_repo("worktree remove"):
        return 1

    wt_dir = WORKTREES_DIR / args.feature_id
    if not wt_dir.is_dir():
        print(f"Error: worktree not found: {wt_dir}")
        print("Hint: `worktree list` shows existing worktrees")
        return 1

    if not args.force:
        code, out = _run_git("-C", str(wt_dir), "status", "--porcelain")
        changes = [l for l in out.splitlines() if l.strip()] if code == 0 else []
        if changes:
            print(f"Error: worktree {wt_dir} has {len(changes)} uncommitted change(s):")
            for line in changes[:10]:
                print(f"  {line}")
            print("Refusing to remove. Commit inside the worktree, or pass --force to discard them (the branch is kept either way).")
            return 1

    remove_args = ["worktree", "remove"]
    if args.force:
        remove_args.append("--force")
    remove_args.append(str(wt_dir))
    code, out = _run_git(*remove_args)
    if code != 0:
        print(f"Error: git worktree remove failed: {out}")
        print("Hint: if the directory is a leftover not registered with git, remove it manually")
        return 1
    print(f"Removed worktree: {wt_dir}")
    print("Branch kept (feature branches are long-lived)")
    return 0


def worktree_merge(args):
    """Pre-check with legacy merge-tree, then merge feature/<feature-id> into --into (default main).

    Must run from the main working tree; on conflicts nothing is merged (exit 2).
    """
    if not _require_git_repo("worktree merge"):
        return 1

    feature = WORKTREE_BRANCH_PREFIX + args.feature_id
    into = args.into

    # Must run from the main working tree (git-dir == git-common-dir there)
    _, git_dir = _run_git("rev-parse", "--git-dir")
    _, common_dir = _run_git("rev-parse", "--git-common-dir")
    if os.path.abspath(git_dir.strip()) != os.path.abspath(common_dir.strip()):
        print("Error: run merge from the main working tree, not from inside a worktree")
        return 1

    if not _branch_exists(feature):
        print(f"Error: branch {feature} does not exist")
        return 1
    if not _branch_exists(into):
        print(f"Error: target branch {into} does not exist")
        return 1

    # `git merge` lands on the current branch, so require the main tree to be on <into>
    code, cur = _run_git("branch", "--show-current")
    current = cur.strip() if code == 0 else ""
    if current != into:
        print(f"Error: main working tree is on branch '{current or '(detached HEAD)'}', but --into is '{into}'")
        print(f"Hint: run `git checkout {into}` in the main working tree first")
        return 1

    # Pre-check with the legacy 3-arg form (git 2.34 has no --write-tree).
    # Its exit code is NOT a conflict signal (it exits 0 even with conflicts);
    # the clean/conflicted decision comes from the parsed output below.
    code, base = _run_git("merge-base", into, feature)
    if code != 0:
        print(f"Error: could not compute a merge base between {into} and {feature}: {base}")
        return 1
    mcode, mout = _run_git("merge-tree", base.strip(), into, feature)
    if mcode not in (0, 1):
        print(f"Error: git merge-tree pre-check failed: {mout}")
        return 1

    files, raw_sections = _parse_merge_tree_conflicts(mout)
    if files or raw_sections:
        print(f"Conflicts when merging {feature} into {into}:")
        if files:
            for f in files:
                print(f"  - {f}")
        else:
            print("  (merge-tree reported conflicts but no conflicting file sections were parsed)")
        print()
        for raw in raw_sections:
            print(raw)
            print()
        print("conflicts found — report to user and ask how to proceed (abort / --no-commit manual resolution)")
        return 2

    # Clean -> real merge (--no-ff, merge commit message per design)
    merge_args = ["merge", "--no-ff", feature, "-m", f"Merge {feature} into {into}"]
    # Fresh environments may have no git identity; fall back to a local one.
    _, email = _run_git("config", "--get", "user.email")
    _, name = _run_git("config", "--get", "user.name")
    if not email.strip() or not name.strip():
        merge_args = ["-c", "user.name=orchestrator-merge", "-c", "user.email=orchestrator@local"] + merge_args
    code, out = _run_git(*merge_args)
    if code != 0:
        # Best-effort: never leave a half-merged state behind (rare: rename cases
        # the legacy merge-tree pre-check cannot model).
        if _run_git("rev-parse", "-q", "--verify", "MERGE_HEAD")[0] == 0:
            _run_git("merge", "--abort")
            print("Error: git merge failed unexpectedly; merge aborted, main working tree restored")
        else:
            print("Error: git merge failed (nothing was merged)")
        print(f"  git said: {out}")
        return 1
    print(f"Merged {feature} into {into}")
    print("Branch kept (feature branches are long-lived)")
    return 0


# ==================== Doctor Command ====================
# Hygiene scan (WP6c-1). It reports and NEVER blocks: the exit code is always
# 0. The SessionStart hook (session-init.py) probes it for its "Health"
# section; outside a repo it prints a single marker line instead of failing,
# so the probe degrades cleanly.

# Feature/task ids of the `{role}-{YYYYMMDD}-{seq}` shape; a commit author
# matching this on main's first-parent chain means a child committed directly
# to main (branch discipline violation). Commits integrated by the main
# agent's merge land on second parents and are invisible to the first-parent
# scan — legitimate integration must never be flagged.
TASK_AUTHOR_RE = re.compile(r"^[a-z]+-[0-9]{8}-[0-9]+$")

# (4) Dual-install drift. The skill source is deployed to several installs
# (SKILL.md "Deployment rules"), and a copy left behind silently changes
# runtime behaviour, so doctor diffs the repo's HEAD *tracked* sources against
# the user-scoped copy at ~/.agents/skills/orch-lite.
#   - the HEAD side is read from git (`ls-tree`), never the working tree, so
#     uncommitted edits and stray files here are not reported as drift;
#   - the copy side is hashed the same way git hashes a blob (sha1 of
#     "blob <size>\0content"), so both sides are directly comparable;
#   - an absent copy means "this machine carries only the git repo" -> lenient,
#     no findings and no error.
# The compared set is the skill's own top-level source roots.
DRIFT_SOURCE_ROOTS = ("SKILL.md", ".gitignore", "hooks", "references", "scripts", "tests")
# Plugin layout (Phase 1): SKILL.md moves to skills/orch-lite/SKILL.md while the
# other source roots stay put, so HEAD (and a plugin-form copy) may carry the
# skill either way. Both comparison sides are normalized to the SKILL.md ROLE
# (flat name) below, which makes a flat copy vs a plugin HEAD -- or the reverse
# -- match by role instead of reporting every path missing/extra.
DRIFT_PLUGIN_SKILL_MD = "skills/orch-lite/SKILL.md"
# A repo is only comparable when HEAD looks like the skill source; otherwise an
# unrelated orchestrated project would report every copy file as "extra".
DRIFT_REPO_MARKERS = ("SKILL.md", "scripts/multi-agent")
DEFAULT_COMPARE_DIR = os.path.join(os.path.expanduser("~"), ".agents", "skills", "orch-lite")
# One `git ls-tree -r <rev> -z` record: `--format` is unavailable on the git 2.34
# baseline here, and -z (instead of the default format) keeps paths raw rather
# than C-quoted, so they line up with the names os.walk reports.
_LS_TREE_RE = re.compile(r"^[0-7]{6} blob ([0-9a-f]{40})\t(.+)$")
# Copy-side noise that is never part of the source set.
_DRIFT_IGNORED_DIRS = frozenset({"__pycache__", ".git"})
# Distinguishes "absent from the copy" from "present but unreadable" (None hash).
_ABSENT = object()


def _blob_sha(path: Path) -> Optional[str]:
    """Git-style blob hash of a file's bytes, or None when it cannot be read."""
    try:
        data = path.read_bytes()
    except OSError:
        return None
    digest = hashlib.sha1()
    digest.update(b"blob %d\0" % len(data))
    digest.update(data)
    return digest.hexdigest()


def _normalize_skill_md_role(blobs: Dict[str, Any]) -> Dict[str, Any]:
    """Collapse the SKILL.md role across layouts, in place.

    skills/orch-lite/SKILL.md (plugin) and SKILL.md (flat) are the same file
    role, so the drift comparison matches them across installs. When a tree
    somehow carries both, the flat entry wins.
    """
    plugin = blobs.pop(DRIFT_PLUGIN_SKILL_MD, _ABSENT)
    if plugin is not _ABSENT and "SKILL.md" not in blobs:
        blobs["SKILL.md"] = plugin
    return blobs


def _head_tracked_blobs() -> Optional[Dict[str, str]]:
    """{path: blob sha} for HEAD's tracked skill sources, or None when HEAD is unusable.

    Pathspecs cover the flat roots plus the plugin SKILL.md location (a no-op
    pathspec under the flat layout), then normalize to role keys so the
    DRIFT_REPO_MARKERS gate and the comparison below are layout-agnostic.
    """
    try:
        code, out = _run_git(
            "ls-tree", "-r", "-z", "HEAD", "--", *DRIFT_SOURCE_ROOTS, DRIFT_PLUGIN_SKILL_MD
        )
    except ValueError:
        # Tracked path bytes that are not valid UTF-8: degrade to "no comparison"
        # rather than crash the scan (doctor's never-raises contract).
        return None
    if code != 0:
        return None
    blobs: Dict[str, str] = {}
    for record in out.split("\0"):
        match = _LS_TREE_RE.match(record)
        if match:
            blobs[match.group(2)] = match.group(1)
    return _normalize_skill_md_role(blobs)


def _copy_blobs(compare_dir: Path) -> Dict[str, Optional[str]]:
    """{relative path: blob sha} for the skill sources inside the comparison copy.

    A None value means the file exists but could not be read; paths absent from
    the copy are simply not keys (callers use _ABSENT to tell the two apart).
    The SKILL.md role is normalized across layouts: a plugin-form copy's
    skills/orch-lite/SKILL.md counts as its SKILL.md entry.
    """
    blobs: Dict[str, Optional[str]] = {}
    for root in DRIFT_SOURCE_ROOTS:
        top = compare_dir / root
        if top.is_file():
            blobs[root] = _blob_sha(top)
            continue
        if not top.is_dir():
            continue
        for dirpath, dirnames, filenames in os.walk(top):
            dirnames[:] = sorted(d for d in dirnames if d not in _DRIFT_IGNORED_DIRS)
            # Relative to `top`, so a relative --compare-dir (including ".") and
            # symlinked roots both yield repo-relative source paths.
            sub = Path(dirpath).relative_to(top).parts
            for name in sorted(filenames):
                if name.endswith(".pyc"):
                    continue
                rel = "/".join((root, *sub, name))
                blobs[rel] = _blob_sha(Path(dirpath) / name)
    if "SKILL.md" not in blobs:
        # Plugin-form copy: the SKILL.md role lives outside the flat roots.
        plugin_top = compare_dir / DRIFT_PLUGIN_SKILL_MD
        if plugin_top.is_file():
            blobs["SKILL.md"] = _blob_sha(plugin_top)
    return blobs


def _doctor_drift_findings(compare_dir: Path) -> List[str]:
    """(4) Drift between HEAD's tracked skill sources and the comparison copy.

    No findings (and no error) when the copy is absent or is not a directory,
    when HEAD is unusable, or when HEAD does not look like the skill source;
    when the two installs agree the output is likewise nothing at all. Both
    sides are role-normalized for SKILL.md (flat vs plugin layout), so
    cross-layout installs compare by role and drift lines name the flat path.
    """
    if not compare_dir.is_dir():
        return []
    head = _head_tracked_blobs()
    if not head or not all(marker in head for marker in DRIFT_REPO_MARKERS):
        return []
    in_copy = _copy_blobs(compare_dir)

    findings: List[str] = []
    for path in sorted(set(head) | set(in_copy)):
        head_sha, copy_sha = head.get(path), in_copy.get(path, _ABSENT)
        if copy_sha is _ABSENT:
            findings.append(f"drift: {path} (tracked in HEAD, missing in copy)")
        elif head_sha is None:
            findings.append(f"drift: {path} (present in copy, not tracked in HEAD)")
        elif copy_sha is None:
            findings.append(f"drift: {path} (present in copy but unreadable)")
        elif copy_sha != head_sha:
            findings.append(f"drift: {path} (HEAD {head_sha[:12]} != copy {copy_sha[:12]})")
    return findings


def doctor_command(args):
    """Repo hygiene scan: (1) dirty worktrees, (2) feature_id-authored commits
    made directly on main (a first-parent scan, so merge-integrated feature
    commits do not surface), (3) HEAD-vs-copy install drift (--compare-dir,
    default ~/.agents/skills/orch-lite). Always exits 0. Reads git only —
    no state file."""
    code, _ = _run_git("rev-parse", "--is-inside-work-tree")
    if code != 0:
        print("(doctor: not a repo)")
        return 0

    findings: List[str] = []

    # (1) per .worktrees/<feature-id>: dirty (uncommitted changes). Pure git.
    if WORKTREES_DIR.is_dir():
        for child in sorted(WORKTREES_DIR.iterdir()):
            if not child.is_dir():
                continue
            fid = child.name
            scode, sout = _run_git("-C", str(child), "status", "--porcelain")
            changes = [l for l in sout.splitlines() if l.strip()] if scode == 0 else []
            if changes:
                paths = ", ".join(l[3:].split(" -> ")[-1] for l in changes[:3])
                findings.append(f"dirty: {fid} ({len(changes)} changes: {paths})")

    # (2) feature_id-authored commits made directly on main -- last ~30 on
    # main's first-parent chain, only checked while on main. --first-parent
    # walks the merge commits themselves, not the task-authored commits they
    # brought in, so a properly integrated feature shows no violation while a
    # direct commit on main still does.
    bcode, bout = _run_git("branch", "--show-current")
    if bcode == 0 and bout.strip() == "main":
        lcode, lout = _run_git("log", "--first-parent", "-n", "30", "--format=%an%x00%h")
        if lcode == 0:
            for line in lout.splitlines():
                author, sep, short = line.partition("\x00")
                if sep and TASK_AUTHOR_RE.match(author.strip()):
                    findings.append(f"main-violation: {author.strip()} {short.strip()}")

    # (3) HEAD-vs-copy install drift (independent of the checks above: a separate
    # finding family, skipped silently when the copy is not there).
    findings.extend(_doctor_drift_findings(Path(args.compare_dir).expanduser()))

    if findings:
        for finding in findings:
            print(finding)
    else:
        print("doctor: all clear")
    return 0


# ==================== Main ====================

def main():
    parser = argparse.ArgumentParser(description="Orch-lite CLI")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # worktree
    worktree_parser = subparsers.add_parser(
        "worktree",
        help="Git worktree operations (.worktrees/<feature-id>, branch feature/<feature-id>; branches are long-lived)")
    worktree_sub = worktree_parser.add_subparsers(dest="worktree_cmd", required=True)

    create_wt = worktree_sub.add_parser("create", help="Create (or reuse) .worktrees/<feature-id>/ on branch feature/<feature-id>")
    create_wt.add_argument("--feature-id", required=True, help="Feature ID (worktree directory name; branch feature/<feature-id>)")
    create_wt.add_argument("--base", default="main", help="Base ref when the branch must be created (default: main)")

    worktree_sub.add_parser("list", help="List worktrees under .worktrees/, grouped by feature branch")

    remove_wt = worktree_sub.add_parser("remove", help="Remove a worktree (never deletes the branch)")
    remove_wt.add_argument("--feature-id", required=True, help="Feature ID (worktree directory name)")
    remove_wt.add_argument("--force", action="store_true", help="Discard uncommitted changes and remove anyway")

    merge_wt = worktree_sub.add_parser("merge", help="Pre-check with merge-tree, then merge feature/<feature-id> into --into")
    merge_wt.add_argument("--feature-id", required=True, help="Feature ID -> branch feature/<feature-id>")
    merge_wt.add_argument("--into", default="main", help="Target branch (default: main)")

    # doctor
    doctor_p = subparsers.add_parser(
        "doctor",
        help="Hygiene scan: dirty worktrees, feature_id-authored commits made directly on main via a "
             "first-parent scan, HEAD-vs-copy install drift (always exits 0)")
    doctor_p.add_argument(
        "--compare-dir", default=DEFAULT_COMPARE_DIR,
        help="Check (3): install to compare HEAD's tracked sources against "
             "(default: ~/.agents/skills/orch-lite; no finding when it does not exist)")

    args = parser.parse_args()

    # Fail-soft net: an OSError escaping any handler must surface as ONE human
    # line, never a traceback (exit 1: a writer must not pretend success).
    try:
        return _dispatch(args, parser)
    except OSError as exc:
        reason = getattr(exc, "strerror", None) or type(exc).__name__
        print(f"error: {reason}")
        return 1


def _dispatch(args, parser) -> int:
    """Route the parsed args to its command handler (called under the fail-soft net)."""
    if args.command == "worktree":
        if args.worktree_cmd == "create":
            return worktree_create(args)
        elif args.worktree_cmd == "list":
            return worktree_list(args)
        elif args.worktree_cmd == "remove":
            return worktree_remove(args)
        elif args.worktree_cmd == "merge":
            return worktree_merge(args)
    elif args.command == "doctor":
        return doctor_command(args)

    parser.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
